[Unit]
Description=Roll back Schéma to trusted release %i
After=network.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/schema-update/apply.py rollback %i
ExecStopPost=/usr/bin/python3 /usr/local/libexec/schema-update/apply.py recover --live
TimeoutStartSec=180
TimeoutStopSec=45
